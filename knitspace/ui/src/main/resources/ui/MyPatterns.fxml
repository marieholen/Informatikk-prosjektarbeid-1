<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600" prefWidth="950" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.MyPatternsController">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #f5f5f5;">
            <padding>
                <Insets bottom="15" left="20" right="20" top="15" />
            </padding>
            <Label text="KnitSpace">
            <HBox.margin>
               <Insets />
            </HBox.margin>
            <padding>
               <Insets right="10.0" />
            </padding>
            <font>
               <Font name="Arial Hebrew Scholar Bold" size="55.0" />
            </font></Label>
            <Pane HBox.hgrow="ALWAYS" /> <!-- spacer -->
            <Button fx:id="btnLogout" style="-fx-background-color: E6D8C3;" text="Log out">
            <padding>
               <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
            </padding>
            <font>
               <Font size="16.0" />
            </font></Button>
        </HBox>
    </top>

    <!-- LEFT: SEARCH & FILTER -->
    <left>
        <VBox alignment="TOP_LEFT" prefWidth="230.0" spacing="12" style="-fx-background-color: ffffff;">
            <padding>
                <Insets bottom="18" left="12" right="12" top="18" />
            </padding>

            <TextField fx:id="searchField" promptText="Search...">
            <VBox.margin>
               <Insets top="5.0" />
            </VBox.margin></TextField>

            <Label text="Filter">
            <font>
               <Font name="Arial Hebrew" size="20.0" />
            </font>
            <VBox.margin>
               <Insets top="10.0" />
            </VBox.margin></Label>
            <Label text="Difficulty level:" />
            <ComboBox fx:id="difficultyFilter" promptText="All">
            <VBox.margin>
               <Insets />
            </VBox.margin></ComboBox>

            <Label text="Yarn type:" />
            <ComboBox fx:id="yarnFilter" promptText="All" />

            <Label text="Clothing type:" />
            <ComboBox fx:id="clothingFilter" promptText="All" />

            <Label text="Status:" />
            <ComboBox fx:id="statusFilter" promptText="All" />

            <Pane VBox.vgrow="ALWAYS" /> <!-- push button to bottom -->
            <Button fx:id="btnNewPattern" alignment="TOP_LEFT" contentDisplay="CENTER" style="-fx-background-color: #a7cbe4;" text="New pattern" textFill="WHITE">
            <font>
               <Font name="Arial Hebrew Scholar Bold" size="18.0" />
            </font>
            <padding>
               <Insets bottom="8.0" left="50.0" right="50.0" top="8.0" />
            </padding></Button>
         <BorderPane.margin>
            <Insets bottom="15.0" left="15.0" right="10.0" />
         </BorderPane.margin>
        </VBox>
    </left>

    <!-- CENTER: PATTERNS TABLE -->
    <center>
        <VBox spacing="8" style="-fx-background-color: ffffff;">
            <padding>
                <Insets bottom="20" left="20" right="20" top="18" />
            </padding>

            <Label text="My patterns">
            <font>
               <Font name="Arial Hebrew Scholar" size="36.0" />
            </font></Label>
            <!-- <TableView fx:id="patternsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colTitle" prefWidth="200.0" style="fx-font-family: Arial;" text="Title" />
                    <TableColumn fx:id="colClothingType" prefWidth="120.0" text="Clothing Type" />
                    <TableColumn fx:id="colDifficulty" prefWidth="100" text="Difficulty" />
                    <TableColumn fx:id="colStatus" prefWidth="120" text="Status" />
                    <TableColumn fx:id="colActions" prefWidth="90" text="Details" />
                </columns>
            </TableView> -->
            
         <BorderPane.margin>
            <Insets bottom="15.0" left="10.0" right="15.0" />
         </BorderPane.margin>
        </VBox>
    </center>

</BorderPane>
