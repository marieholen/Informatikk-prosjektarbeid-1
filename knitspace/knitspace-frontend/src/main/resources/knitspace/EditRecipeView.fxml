<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="mainContainer" alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" spacing="20.0" style="-fx-background-color: white; -fx-padding: 20;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="knitspace.EditRecipeController">
   <children>
      <Label fx:id="titleLabel" text="Edit Recipe">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <GridPane fx:id="formGrid" hgap="10.0" prefWidth="550.0" vgap="10.0">
        <columnConstraints>
          <javafx.scene.layout.ColumnConstraints hgrow="SOMETIMES" maxWidth="290.0" minWidth="10.0" prefWidth="120.0" />
          <javafx.scene.layout.ColumnConstraints hgrow="SOMETIMES" maxWidth="450.0" minWidth="10.0" prefWidth="430.0" />
        </columnConstraints>
        <rowConstraints>
          <javafx.scene.layout.RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <javafx.scene.layout.RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <javafx.scene.layout.RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <javafx.scene.layout.RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <javafx.scene.layout.RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <javafx.scene.layout.RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label fx:id="titleFieldLabel" text="Title:" />
            <TextField fx:id="titleField" GridPane.columnIndex="1" />
            <Label fx:id="descriptionFieldLabel" text="Description:" GridPane.rowIndex="1" />
            <TextField fx:id="descriptionField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label fx:id="difficultyFieldLabel" text="Difficulty level:" GridPane.rowIndex="2" />
            <ComboBox fx:id="difficultyComboBox" prefHeight="26.0" prefWidth="430.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label fx:id="yarnTypeFieldLabel" text="Yarn type:" GridPane.rowIndex="3" />
            <ComboBox fx:id="yarnTypeComboBox" prefHeight="26.0" prefWidth="430.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Label fx:id="needleSizeFieldLabel" text="Needle size:" GridPane.rowIndex="4" />
            <ComboBox fx:id="needleSizeComboBox" prefHeight="26.0" prefWidth="430.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <Label fx:id="statusFieldLabel" text="Status:" GridPane.rowIndex="5" />
            <ComboBox fx:id="statusComboBox" prefHeight="26.0" prefWidth="430.0" GridPane.columnIndex="1" GridPane.rowIndex="5" />
         </children>
      </GridPane>
      <HBox fx:id="buttonContainer" alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
         <children>
            <Button fx:id="uploadPdfButton"
                    mnemonicParsing="false"
                    style="-fx-background-color: #d1d1d1; -fx-padding: 8 16; -fx-background-radius: 5;"
                    text="Upload PDF"
                    onAction="#handleUploadPdf" />
            <Button fx:id="saveButton"
                    mnemonicParsing="false"
                    style="-fx-background-color: #b3d79bff; -fx-padding: 8 16; -fx-background-radius: 5;"
                    text="Save"
                    onAction="#handleSaveButton" />
            <Button fx:id="backButton"
                    mnemonicParsing="false"
                    style="-fx-background-color: #e4aba0ff; -fx-padding: 8 16; -fx-background-radius: 5;"
                    text="Back"
                    onAction="#handleBackButton" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
